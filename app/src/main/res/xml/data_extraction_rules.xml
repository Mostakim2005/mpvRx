<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
  <cloud-backup>
    <include domain="database" path="." />
    <include domain="sharedpref" path="." />
    <!-- Exclude pairing secrets and sensitive local vault stores from cloud backup -->
    <exclude domain="sharedpref" path="remote_control.xml" />
    <exclude domain="database" path="secure_vault.db" />
    <exclude domain="database" path="secure_vault.db-wal" />
    <exclude domain="database" path="secure_vault.db-shm" />
  </cloud-backup>
  <device-transfer>
    <include domain="database" path="." />
    <include domain="sharedpref" path="." />
    <exclude domain="sharedpref" path="remote_control.xml" />
  </device-transfer>
</data-extraction-rules>
